    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260625.1",
    "miniflare": "4.20260625.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.105.0"
  }
