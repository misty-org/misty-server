{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "misty-journal-collab",
  "main": "src/index.ts",
  "workers_dev": true,
  "compatibility_date": "2026-06-25",
  "compatibility_flags": ["nodejs_compat"],

  "observability": { "enabled": true },

  "durable_objects": {
    "bindings": [
      { "name": "NOTE_ROOM", "class_name": "NoteRoom" },
      { "name": "CODE_ROOM", "class_name": "CodeRoom" },
      { "name": "APP_ROOM", "class_name": "AppRoom" },
      { "name": "FILE_ROOM", "class_name": "FileRoom" },
    ],
  },

  // SQLite-backed Durable Objects. This is deliberate: the key-value backed
  // classes are the older form, and SQLite storage is what y-partyserver
  // expects for document persistence.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["NoteRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["DrawingRoom"] },
    { "tag": "v3", "new_sqlite_classes": ["ImageRoom"] },
    { "tag": "v4", "new_sqlite_classes": ["CodeRoom"] },
    { "tag": "v5", "new_sqlite_classes": ["DeckRoom", "WorkbookRoom"] },
    // Misty no longer has its own Space apps: whiteboards, image edits, decks and workbooks
    // are gone, with their rooms' storage.
    { "tag": "v6", "deleted_classes": ["DrawingRoom", "ImageRoom", "DeckRoom", "WorkbookRoom"] },
    // Apps' live documents (the SDK's `room()`).
    { "tag": "v7", "new_sqlite_classes": ["AppRoom"] },
    // Space files opened as live documents (the SDK's `room.forFile()`), with one writer's lease each.
    { "tag": "v8", "new_sqlite_classes": ["FileRoom"] },
  ],

  "vars": {
    // Non-secret configuration. Every secret is set with `wrangler secret put`
    // and never appears in this file.
    // Your API base; the server's setup container sets it from MISTY_HOSTNAME.
    "MISTY_INTERNAL_API_BASE": "https://api.example.com/v1",
    "JOURNAL_COLLAB_ISSUER": "misty-api",
    "JOURNAL_COLLAB_AUDIENCE": "misty-journal-collab",
  },
}
