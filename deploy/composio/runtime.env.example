# Composio Cloud powers connected apps. Copy this file to
# server/.env/dev/integrations/composio.env (or the prod equivalent).
MISTY_COMPOSIO_DEPLOYMENT=cloud
# Put the dashboard project key as COMPOSIO_API_KEY in server/.env/dev/composio.env
# (or prod/composio.env). Alternatively set MISTY_COMPOSIO_API_KEY here; it takes
# precedence. Never expose either key through VITE_* or a browser bundle.
