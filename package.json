{
  "name": "@misty/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/api",
    "apps/payments"
  ],
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev:api": "tsx watch apps/api/src/main.ts",
    "dev:payments": "tsx watch apps/payments/src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:api": "node dist/apps/api/src/main.js",
    "start:payments": "node dist/apps/payments/src/main.js",
    "admin": "tsx apps/api/src/admin.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "migration:inventory": "node scripts/migration/inventory.mjs",
    "migration:coverage": "npm run build && node scripts/migration/native-coverage.mjs",
    "contracts:sync": "node scripts/migration/sync-contracts.mjs && node scripts/migration/sync-go-contracts.mjs",
    "contracts:check": "node scripts/migration/sync-contracts.mjs --check",
    "migrate": "tsx apps/api/src/migrate.ts",
    "migrate:payments": "tsx apps/payments/src/migrate.ts",
    "import:legacy-purchases": "tsx apps/payments/src/import-legacy-purchases.ts",
    "import:legacy-subscriptions": "tsx apps/payments/src/import-legacy-subscriptions.ts",
    "catalog:sync": "node scripts/migration/sync-app-catalog.mjs",
    "catalog:check": "node scripts/migration/sync-app-catalog.mjs --check",
    "check": "node scripts/migration/sync-go-contracts.mjs --check && npm run catalog:check && npm run typecheck && npm run test:unit && npm run build",
    "initialize:entitlements": "tsx apps/payments/src/initialize-entitlements.ts",
    "import:legacy-checkouts": "tsx apps/payments/src/import-legacy-checkouts.ts",
    "recover:legacy-checkouts": "tsx apps/payments/src/recover-legacy-checkouts.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@misty/contracts": "file:third-party/misty-contracts",
    "hono": "4.13.7",
    "jose": "6.2.11",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "6.0.0",
    "@types/libmime": "5.3.0",
    "@types/mailparser": "3.4.6",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "^8.15.0",
    "@types/pngjs": "6.0.5",
    "mailparser": "3.9.20",
    "pngjs": "7.0.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
