# Nightly encrypted database backup. Install on the VPS:
#   sudo cp misty-backup.service misty-backup.timer /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now misty-backup.timer
# Adjust User and WorkingDirectory to the account and Misty checkout that run
# `misty server prod up`.
[Unit]
Description=Misty production database backup
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=misty
WorkingDirectory=/home/misty/misty
ExecStart=/usr/bin/env misty server prod backup
