package console

templ logsPage(v servicesView, composeFile string) {
	@pageHeader("Logs", composeFile+" · last 200 lines per service")
	if v.Err != "" {
		@problem(v.Err)
		@note("Logs come from docker compose on the machine running the console. The server stack's console runs in a container without Docker; on the host, docker compose logs prints them.")
	}
	<ul class="rows compact">
		for _, service := range v.Services {
			<li class="row">
				<span class="row-label">{ service.Service }</span>
				<button class="link-button" hx-get={ "/logs/" + service.Service + "/logs" } hx-target="#logs" hx-swap="outerHTML">
					@iconFileText()
					<span>Show logs</span>
				</button>
			</li>
		}
		if len(v.Services) == 0 && v.Err == "" {
			@emptyRow("No containers are running.")
		}
	</ul>
	<div id="logs">
		@note("Choose a service to follow its output here.")
	</div>
}
