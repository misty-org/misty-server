{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "misty-journal-collab",
  "main": "src/index.ts",
  "workers_dev": true,
  "compatibility_date": "2026-06-25",
  "compatibility_flags": ["nodejs_compat"],

  "observability": { "enabled": true },

  "durable_objects": {
    "bindings": [
      { "name": "NOTE_ROOM", "class_name": "NoteRoom" },
      { "name": "DRAWING_ROOM", "class_name": "DrawingRoom" },
    ],
  },

  // SQLite-backed Durable Objects. This is deliberate: the key-value backed
  // classes are the older form, and SQLite storage is what y-partyserver
  // expects for document persistence.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["NoteRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["DrawingRoom"] },
  ],

  "vars": {
    // Non-secret configuration. Every secret is set with `wrangler secret put`
    // and never appears in this file.
    "MISTY_INTERNAL_API_BASE": "https://api.mistysys.com/v1",
    "JOURNAL_COLLAB_ISSUER": "misty-api",
    "JOURNAL_COLLAB_AUDIENCE": "misty-journal-collab",
  },
}
