package console

import db "github.com/kannachi323/misty/server/internal/platform/postgres"

templ syncPage(v syncView) {
	@pageHeader("Sync", "Vaults, devices and per-device workspaces. Content is end-to-end encrypted; only counts are visible.")
	if v.Err != "" {
		@problem(v.Err)
	}
	<div class="metrics">
		@metric("Vaults", itoa(v.Totals.Vaults))
		@metric("Devices", itoa(v.Totals.Devices))
		@metric("Workspaces", itoa(v.Totals.Workspaces))
		@metric("Active today", itoa(v.Totals.ActiveLastDay))
	</div>
	@sectionLabel("Vaults")
	<div class="table sync-table">
		<div class="table-head"><span>Account</span><span>Devices</span><span>Workspaces</span><span>Head</span><span>Active device</span></div>
		for _, vault := range v.Vaults {
			<div class="table-row">
				<span class="truncate" title={ vault.VaultID }>{ vault.Email }</span>
				<span>
					{ itoa(vault.Devices) }
					if vault.RevokedDevices > 0 {
						<span class="muted">{ " +" + itoa(vault.RevokedDevices) + " revoked" }</span>
					}
				</span>
				<span>{ itoa(vault.Workspaces) }</span>
				<span class="muted">{ "#" + itoa(int(vault.HeadSequence)) + " · epoch " + itoa(int(vault.KeyEpoch)) }</span>
				<span class="muted">
					if vault.ActiveDevice != "" {
						{ vault.ActiveDevice + " · " }
					}
					{ agoPtr(vault.ActiveSeenAt) }
				</span>
			</div>
		}
		if len(v.Vaults) == 0 && v.Err == "" {
			<div class="table-row"><span class="muted">No account has set up sync yet.</span></div>
		}
	</div>
}

templ stateCounts(groups [][]db.ConsoleStateCount) {
	<div class="count-groups">
		for _, group := range groups {
			<div class="count-group">
				<div class="muted">{ group[0].Kind }</div>
				<ul class="rows compact">
					for _, c := range group {
						<li class={ "row", templ.KV("row-problem", problemState(c.State)) }>
							<span>{ humanize(c.State) }</span>
							<span>{ itoa(c.Count) }</span>
						</li>
					}
				</ul>
			</div>
		}
	</div>
}

templ jobsPage(v jobsView) {
	@pageHeader("Jobs", "Workflow schedules, AI invocations, agent runs and library reindexing")
	if v.Err != "" {
		@problem(v.Err)
	}
	if len(v.Counts) > 0 {
		@stateCounts(countGroups(v.Counts))
	}
	@sectionLabel("In progress or failed today")
	<div class="table jobs-table">
		<div class="table-head"><span>Job</span><span>Owner</span><span>State</span><span>Detail</span><span>Updated</span></div>
		for _, job := range v.Jobs {
			<div class={ "table-row", templ.KV("row-problem", problemState(job.State)) }>
				<span class="truncate">
					<span class="muted">{ job.Kind + " · " }</span>{ job.Title }
				</span>
				<span class="truncate muted">{ job.Owner }</span>
				<span>
					@stateTag(job.State)
				</span>
				<span class="truncate muted" title={ job.Detail }>{ job.Detail }</span>
				<span class="muted">{ ago(job.UpdatedAt) }</span>
			</div>
		}
		if len(v.Jobs) == 0 && v.Err == "" {
			<div class="table-row"><span class="muted">Nothing running and no failures in the last day.</span></div>
		}
	</div>
}

templ aiPage(v aiView) {
	@pageHeader("AI", "Model provider and the last day of invocations")
	@sectionLabel("Model")
	<ul class="rows">
		for _, s := range v.Model {
			@settingRow(s)
		}
		if v.Gateway != nil {
			@healthRow(v.Gateway.Label(), v.Gateway.OK(), checkDetail(*v.Gateway))
		}
	</ul>
	@note("Every model routes through the AI gateway. Per-account budgets are enforced by the billing adapter.")
	if v.Err != "" {
		@problem(v.Err)
	}
	@sectionLabel("Invocations in the last day, by mode")
	if len(v.States) > 0 {
		@stateCounts(countGroups(v.States))
	} else {
		@note("No invocations in the last day.")
	}
	if len(v.Failures) > 0 {
		@sectionLabel("Top failure codes")
		<ul class="rows">
			for _, f := range v.Failures {
				<li class="row"><span><code>{ f.State }</code></span><span>{ itoa(f.Count) }</span></li>
			}
		</ul>
	}
}

templ settingRow(s setting) {
	<li class={ "row", templ.KV("row-problem", s.Required && !s.Set) }>
		<span class="row-label">
			if s.Set {
				@iconCheck()
			} else if s.Required {
				@iconAlert()
			} else {
				@iconMinus()
			}
			<code>{ s.Name }</code>
		</span>
		<span class={ "truncate", templ.KV("muted", s.Set || !s.Required) }>{ s.display() }</span>
	</li>
}

templ billingPage(v billingView) {
	@pageHeader("Billing", "Billing adapter delivery and license distribution")
	if v.Err != "" {
		@problem(v.Err)
	}
	<ul class="rows">
		if v.Check != nil {
			@healthRow("Billing adapter", v.Check.OK(), checkDetail(*v.Check))
		}
		@healthRow("Outbox", v.Billing.OutboxRetrying == 0, plural(v.Billing.OutboxPending, "pending event", "pending events")+" · "+itoa(v.Billing.OutboxRetrying)+" retrying · oldest "+agoPtr(v.Billing.OutboxOldest))
		@healthRow("Open reservations", true, itoa(v.Billing.Reservations)+" · oldest "+agoPtr(v.Billing.ReservationsOldest))
	</ul>
	@sectionLabel("Licenses")
	<div class="table">
		<div class="table-head"><span>Tier</span><span>Status</span><span>Accounts</span></div>
		for _, l := range v.Billing.Licenses {
			<div class="table-row">
				<span>{ humanize(l.Kind) }</span>
				<span>
					@stateTag(l.State)
				</span>
				<span>{ itoa(l.Count) }</span>
			</div>
		}
	</div>
}
